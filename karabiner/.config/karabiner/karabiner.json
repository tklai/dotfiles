                                ],
                                "to_if_alone": [{ "key_code": "escape" }],
                                "type": "basic"
                            },
                            {
                                "description": "Avoid starting sysdiagnose with the built-in macOS shortcut cmd+shift+option+ctrl+,",
                                "from": {
                                    "key_code": "comma",
                                    "modifiers": { "mandatory": ["command", "shift", "option", "control"] }
                                },
                                "to": [],
                                "type": "basic"
                            },
